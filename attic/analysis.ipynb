{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Sentinel-2 Floating Debris & Plastic Detection Workflow\n",
    "本笔记展示了从栅格读取、可选掩膜构建，到悬浮物检测和塑料光谱识别的完整流程。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "from sateline_ml.detection import create_mask_tif_from_shp, floating_debris_detection\n",
    "from sateline_ml.train_model import load_plastic_model\n",
    "\n",
    "# 在需要运行塑料光谱分类时，提前检查模型文件是否存在。\n",
    "def _check_model(path: str | None) -> bool:\n",
    "    if path is None:\n",
    "        return False\n",
    "    return Path(path).exists()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === 参数设定 ===\n",
    "# Sentinel-2 多波段 GeoTIFF\n",
    "input_tif = Path('export_tifs_from_merged/2022-02-27_02-49-04.tif')\n",
    "# AOI shapefile（可选）。若无需 shapefile，可设为 None\n",
    "shapefile = Path('数据/taihu.shp')\n",
    "# 输出目录\n",
    "output_dir = Path('analysis_outputs')\n",
    "output_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# 自动生成的水体掩膜 GeoTIFF\n",
    "mask_tif = output_dir / 'water_mask.tif'\n",
    "\n",
    "# Debug 可视化与日志目录\n",
    "debug_dir = output_dir / 'debug'\n",
    "log_file = output_dir / 'run.log'\n",
    "\n",
    "# 可选：塑料光谱模型与谱库（若无则保持 None 暂不使用）\n",
    "plastic_model_path = output_dir / 'plastic_model.pt'  # 示例路径\n",
    "plastic_library_csv = Path('spectral_library/plastic_library.csv')  # 示例路径\n",
    "\n",
    "use_plastic_model = _check_model(plastic_model_path) and plastic_library_csv.exists()\n",
    "print(f'使用塑料模型: {use_plastic_model}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "# === 1. 根据 shapefile（若存在）生成掩膜 ===\n",
    "if shapefile is not None and shapefile.exists():\n",
    "    create_mask_tif_from_shp(shapefile, input_tif, mask_tif)\n",
    "else:\n",
    "    # 若没有 shapefile，可直接使用已有掩膜或下载的 water mask\n",
    "    mask_tif = Path(mask_tif)  # 确保为 Path 类型\n",
    "\n",
    "# === 2. 执行悬浮物检测 + 可选塑料光谱识别 ===\n",
    "kwargs = dict(\n",
    "    input_tif=input_tif,\n",
    "    mask_tif=mask_tif,\n",
    "    shp_file=None if shapefile is None else shapefile,\n",
    "    output_csv=output_dir / 'detections.csv',\n",
    "    preview_png=output_dir / 'preview.png',\n",
    "    debug_dir=debug_dir,\n",
    "    log_file=log_file,\n",
    "    epochs=8,\n",
    "    water_ndwi_thresh=0.03,\n",
    "    floating_thresh=0.55,\n",
    "    suspended_thresh=0.55,\n",
    ")\n",
    "\n",
    "if use_plastic_model:\n",
    "    kwargs |= dict(\n",
    "        plastic_model_path=plastic_model_path,\n",
    "        plastic_library_csv=plastic_library_csv,\n",
    "        plastic_prob_thresh=0.5,\n",
    "    )\n",
    "\n",
    "floating_debris_detection(**kwargs)\n",
    "print('流程完成，结果已输出至:', output_dir)")
   ]
  }
 ],
